def _probe_send_selector(page, svc):
    """Verify the send control by typing a throwaway string, checking the
    button resolves and is enabled, then clearing the field. Never sends.

    Returns (ok, status): ok is True/False for a clear pass/fail, or None when
    it genuinely could not be verified (so doctor warns rather than fails)."""
    probe_text = "conjure doctor probe — ignore"
    field = page.locator(svc["input_sel"])
    try:
        field.click()
        try:
            field.fill(probe_text)
        except Exception:
            page.keyboard.type(probe_text, delay=5)
        time.sleep(0.5)
        send = page.locator(svc["send_sel"])
        count = send.count()
        if count == 0:
            result = (False, f"send button matched nothing: {svc['send_sel']}")
        elif not send.first.is_enabled():
            result = (None, f"send button present but disabled (may just need a moment): {svc['send_sel']}")
        else:
            result = (True, f"send button resolves and is enabled: {svc['send_sel']}")
    except Exception as exc:
        result = (None, f"could not verify send button ({exc})")
    # Always clear the throwaway text so a later real run is unaffected.
    try:
        field.fill("")
    except Exception:
        try:
            page.keyboard.press("Control+A")
            page.keyboard.press("Delete")
        except Exception:
            pass
    return result


def _doctor_probe_service(name, svc):
    """Launch a headless browser, load the service, and report login state plus
    live resolution of the static selectors. Read-only — sends no prompt."""
    print(f"  launching headless browser {ARROW} {svc['url']}")
    try:
        ctx, page = launch_browser(svc["profile"])
    except Exception as exc:
        print(f"  {MARK_BAD} could not launch browser: {exc}")
        return False
    try:
        try:
            page.goto(svc["url"], timeout=30000)
        except Exception as exc:
            print(f"  {MARK_BAD} navigation failed: {exc}")
            return False
        try:
            page.wait_for_selector(svc["input_sel"], timeout=15000)
        except PlaywrightTimeout:
            pass

        # Login gate first: a logged-out page is a login wall, so every
        # downstream selector would falsely read as "broken".
        if not is_logged_in(page, svc):
            print(f"  {MARK_BAD} not logged in {DASH} run: conjure --login {name}")
            print("    (skipping selector checks; the page is a login wall)")
            return False
        print(f"  {MARK_OK} logged in")

        ok = True

        count = page.locator(svc["input_sel"]).count()
        good = count > 0
        ok = ok and good
        print(f"  {MARK_OK if good else MARK_BAD} input selector  ({count} match)  {svc['input_sel']}")

        nc_matched = False
        nc_report = []
        for sel in svc.get("new_chat_sels", []):
            try:
                c = page.locator(sel).count()
            except Exception:
                c = 0
            nc_report.append((sel, c))
            nc_matched = nc_matched or c > 0
        # New-chat has a reload fallback in the real flow, so a miss is a
        # warning, not a hard failure.
        print(f"  {MARK_OK if nc_matched else MARK_WARN} new-chat selector  "
              + ("one variant matched" if nc_matched
                 else "none matched (reload fallback would be used)"))
        for sel, c in nc_report:
            print(f"        {c} match   {sel}")

        send_ok, send_status = _probe_send_selector(page, svc)
        if send_ok is False:
            ok = False
        send_mark = {True: MARK_OK, False: MARK_BAD, None: MARK_WARN}[send_ok]
        print(f"  {send_mark} {send_status}")

        dynamic = [s for s in selector_specs(svc) if s[2] == "dynamic" and s[0] != "send"]
        if dynamic:
            print(f"  {MARK_INFO} dynamic selectors (only verifiable during a real run):")
            for label, sel, _ in dynamic:
                print(f"        {label:<10} {sel}")

        return ok
    finally:
        try:
            ctx.close()
        except Exception:
            pass


def do_doctor(targets):
    """Environment + selector health check. Returns a process exit code."""
    print("conjure doctor")
    print(RULE * 48)

    if cloak_launch is None:
        print(f"{MARK_BAD} dependencies: NOT installed")
        if IMPORT_ERROR:
            print(f"    {IMPORT_ERROR}")
        print("    fix: cd conjure && ./setup")
        return 1
    print(f"{MARK_OK} dependencies: cloakbrowser + playwright import OK")
    print(f"{MARK_INFO} config dir: {CONFIG_DIR} "
          f"({'exists' if CONFIG_DIR.exists() else 'missing (created on first login)'})")

    overall = True
    for name in targets:
        svc = SERVICES[name]
        print()
        print(f"{RULE * 2} {name} {RULE * 14}")
        profile = svc["profile"]
        if profile.exists():
            print(f"  {MARK_OK} profile: {profile}")
        else:
            print(f"  {MARK_BAD} profile missing {DASH} run: conjure --login {name}")
            overall = False
            continue
        if not _doctor_probe_service(name, svc):
            overall = False

    print()
    if overall:
        print("All checks passed.")
    else:
        print(f"Some checks failed {DASH} see above. A '{MARK_BAD}' on a static selector "
              "means the page markup changed; update that selector in the SERVICES table.")
    return 0 if overall else 1


