def do_generate(service_name, prompt, edit_image=None):
    svc = SERVICES[service_name]
    output_dir = Path.cwd()

    if edit_image:
        print(f"Editing ({service_name}): {edit_image.name} — {prompt}")
    else:
        print(f"Generating ({service_name}): {prompt}")

    ctx, page = launch_browser(svc["profile"])

    try:
        debug(f"navigating to {svc['url']}")
        page.goto(svc["url"])
        ensure_logged_in(page, svc)
        debug("logged in; ensuring a fresh chat")
        ensure_fresh_chat(page, svc)

        try:
            page.wait_for_selector(svc["input_sel"], timeout=15000)
        except PlaywrightTimeout:
            raise StepFailure(
                "the prompt input never appeared",
                f"The page layout may have changed, or the session may be invalid. "
                f"Run 'conjure --doctor {service_name}' to check.",
            )
        debug("prompt input ready")

        # Upload image if editing
        if edit_image:
            debug(f"uploading {edit_image}")
            try:
                svc["upload"](page, edit_image)
            except Exception as exc:
                raise StepFailure(
                    f"image upload failed ({exc})",
                    f"The upload control may have changed. "
                    f"Run 'conjure --doctor {service_name}' to check.",
                )
            # Wait for upload preview to appear (not a fixed delay)
            try:
                page.locator('.file-preview-container, img[src*="blob:"]').first.wait_for(timeout=30000)
            except PlaywrightTimeout:
                debug("upload preview did not appear within 30s; continuing anyway")
            time.sleep(1)

        # Type prompt
        textarea = page.locator(svc["input_sel"])
        textarea.click()
        time.sleep(0.3)

        prefix = svc["edit_prefix"] if edit_image else svc["prompt_prefix"]
        full_prompt = prefix + prompt
        try:
            textarea.fill(full_prompt)
        except Exception:
            page.keyboard.type(full_prompt, delay=10)

        time.sleep(0.5)
        baseline = get_page_state(page, svc)

        # Submit — wait for send button to be ready, then verify it went through
        send = page.locator(svc["send_sel"])
        try:
            send.wait_for(state="visible", timeout=10000)
        except PlaywrightTimeout:
            pass
        time.sleep(1)

        if send.count() > 0 and send.is_enabled():
            send.click()
        else:
            page.keyboard.press("Enter")

        # Verify message was sent relative to the pre-submit page state
        sent = wait_for_send_confirmation(page, svc, baseline)
        if not sent:
            debug("send not confirmed; retrying once")
            # Retry send
            send = page.locator(svc["send_sel"])
            if send.count() > 0 and send.is_enabled():
                send.click()
            else:
                page.keyboard.press("Enter")
            time.sleep(10)
            sent = True  # best effort
        else:
            debug("send confirmed")

        before_srcs = baseline["image_srcs"]

        print("Waiting for image generation (this can take a minute)...")

        if not wait_response_done(page, svc, timeout=180):
            debug("wait_response_done timed out after 180s")
            print("Warning: timed out waiting for response.")
        else:
            debug("response generation complete")

        print("Waiting for image to finish rendering...")
        if not wait_for_images(page, before_srcs, svc):
            debug("wait_for_images timed out")
            print("Warning: images may not be fully rendered.")
        else:
            debug("image detected in response")

        # Find and save the best image
        timestamp = datetime.now().strftime("%Y%m%d-%H%M%S")
        slug = slugify(prompt)
        filename = f"{slug}-{timestamp}.png"
        filepath = output_dir / filename

        best = find_best_image(page, before_srcs)
        if not best:
            # Retry — image may still be loading
            for _ in range(3):
                time.sleep(10)
                try:
                    check_for_failure(page, svc)
                except ServiceFailure:
                    raise
                best = find_best_image(page, before_srcs)
                if best:
                    break

        if best and save_image(page, best, filepath, service_name):
            print(f"Saved: {filepath}")
            debug("image saved successfully")
        else:
            assistant_text = _latest_assistant_text(page, svc)
            if best:
                print("Found an image in the response but could not save it.")
            elif assistant_text:
                print(
                    f"No image in response. {service_name} replied with text:\n  "
                    + assistant_text.replace("\n", "\n  ")
                )
            else:
                print(f"No image found in the {service_name} response.")
            dest = capture_diagnostics(
                page,
                svc,
                "image found but save failed" if best else "no image in response",
            )
            if dest:
                print(f"Diagnostics saved: {dest}")
            sys.exit(4)

    except ServiceFailure as exc:
        # Let the assistant finish streaming before snapshotting the reply,
        # otherwise the printed message may be truncated mid-word.
        try:
            time.sleep(2)
            final_text = _latest_assistant_text(page, svc) or exc.message
        except Exception:
            final_text = exc.message
        label = {
            "quota": "image quota reached",
            "error": "could not generate image",
        }.get(exc.reason, exc.reason)
        print(
            f"\n{service_name}: {label}. Response:\n  "
            + final_text.replace("\n", "\n  ")
        )
        sys.exit(2)
    except StepFailure as exc:
        print(f"\n{service_name}: {exc.step}.")
        if exc.hint:
            print(f"  {exc.hint}")
        dest = capture_diagnostics(page, svc, exc.step)
        if dest:
            print(f"  Diagnostics saved: {dest}")
        sys.exit(3)
    except KeyboardInterrupt:
        print("\nCancelled.")
    except Exception as exc:
        debug(f"unexpected error: {exc!r}")
        print(f"\nUnexpected error: {exc}")
        dest = capture_diagnostics(page, svc, f"unexpected: {type(exc).__name__}: {exc}")
        if dest:
            print(f"  Diagnostics saved: {dest}")
        sys.exit(1)
    finally:
        try:
            ctx.close()
        except Exception:
            pass


def _send_prompt(page, svc, text, edit_image=None):
    """Type text (optionally after uploading an image) into the composer and
    submit it. Assumes the input selector is already present. Returns
    (sent, baseline) where baseline is the pre-send page state (its image_srcs
    let a caller diff out images that were already on the page)."""
    if edit_image:
        debug(f"uploading {edit_image}")
        try:
            svc["upload"](page, edit_image)
        except Exception as exc:
            raise StepFailure(
                f"image upload failed ({exc})",
                "The upload control may have changed. Run 'conjure doctor gemini' to check.",
            )
        try:
            page.locator('img[src*="blob:"]').first.wait_for(timeout=30000)
        except PlaywrightTimeout:
            debug("upload preview did not appear within 30s; continuing anyway")
        time.sleep(1)

    field = page.locator(svc["input_sel"])
    field.click()
    time.sleep(0.2)
    try:
        field.fill(text)
    except Exception:
        page.keyboard.type(text, delay=10)
    time.sleep(0.3)

    baseline = get_page_state(page, svc)
    send = page.locator(svc["send_sel"])
    try:
        send.wait_for(state="visible", timeout=10000)
    except PlaywrightTimeout:
        pass
    time.sleep(0.5)
    if send.count() > 0 and send.is_enabled():
        send.click()
    else:
        page.keyboard.press("Enter")

    sent = wait_for_send_confirmation(page, svc, baseline)
    if not sent:
        debug("send not confirmed; retrying once")
        send = page.locator(svc["send_sel"])
        if send.count() > 0 and send.is_enabled():
            send.click()
        else:
            page.keyboard.press("Enter")
        time.sleep(10)
        sent = True  # best effort
    else:
        debug("send confirmed")
    return sent, baseline


_CONV_ID_RE = re.compile(r"/app/([0-9a-fA-F]{6,})")
# A genuine sidebar conversation link is a clean /app/<hex> with no trailing
# query junk; the account/profile link embeds /app/<id>&ec=... and is excluded.
_CONV_HREF_RE = re.compile(r"^(?:https://gemini\.google\.com)?/app/([0-9a-fA-F]{6,})/?$")


def _conversation_id(url):
    """Extract the Gemini conversation id from a URL, or None. Stops at the
    hex run, so tracking params (&ec=…, ?foo) don't leak into the id."""
    if not url:
        return None
    m = _CONV_ID_RE.search(url)
    return m.group(1) if m else None


def _conversation_title(page):
    """The conversation's title from the tab (Gemini sets document.title to
    '<title> - Google Gemini' once the chat is named), or None if unnamed."""
    try:
        title = (page.title() or "").strip()
    except Exception:
        return None
    for suffix in (" - Google Gemini", " – Google Gemini", " - Gemini", " | Gemini"):
        if title.endswith(suffix):
            title = title[: -len(suffix)].strip()
            break
    if not title or title.lower() in ("google gemini", "gemini"):
        return None
    return title


def _image_bytes(page, img_element, service_name):
    """Save an image element via the normal path and return its PNG bytes."""
    fd, tmp = tempfile.mkstemp(suffix=".png")
    os.close(fd)
    tmp_path = Path(tmp)
    try:
        if save_image(page, img_element, tmp_path, service_name):
            return tmp_path.read_bytes()
    except Exception as exc:
        debug(f"_image_bytes failed: {exc}")
    finally:
        tmp_path.unlink(missing_ok=True)
    return None


def _request_image_b64(page, src):
    """Fetch an image URL via Playwright's request API — uses the browser's
    cookies and runs server-side, so it bypasses CORS and canvas-taint (needed
    for cross-origin user uploads on googleusercontent). Returns base64."""
    if not src or src.startswith(("data:", "blob:")):
        return None
    try:
        resp = page.request.get(src, timeout=15000)
        if resp.ok:
            return base64.b64encode(resp.body()).decode()
    except Exception as exc:
        debug(f"_request_image_b64 failed: {exc}")
    return None


def _reply_progressed(page, svc, before, before_reply):
    """True if a new assistant reply has appeared since `before` — detected by
    reply-node count, changed text, or a new image (image-only replies may add
    no text). Used to tell a real reply from a silently-lost send."""
    try:
        st = get_page_state(page, svc)
    except Exception:
        return False
    if st["response_nodes"] > before["response_nodes"]:
        return True
    current = _latest_assistant_text(page, svc) or ""
    if current and current != before_reply:
        return True
    return bool(find_new_images(page, before["image_srcs"]))


def chat_once(page, svc, message, continue_id=None, upload_path=None):
    """Run one chat turn on an EXISTING (warm) page — no launch or close.

    Starts a fresh chat, or resumes continue_id, optionally attaches a file
    (upload_path), sends the message, waits for the reply, and harvests any
    images. Returns {reply, conversation_id, images, title} (images = PNG byte
    strings; title scraped from the tab). Raises ServiceFailure on a quota wall
    and StepFailure if the page looks broken. Shared by the CLI and API."""
    if continue_id:
        want = _conversation_id(continue_id) or continue_id
        if _conversation_id(page.url) == want:
            debug(f"already on conversation {want}; skipping navigation")
        else:
            target = continue_id if "/app/" in continue_id else f"{svc['url'].rstrip('/')}/{continue_id}"
            page.goto(target)
            time.sleep(2)
            if not has_conversation_history(page, svc):
                debug("continue: no history loaded for that id; sending as a new turn")
    else:
        ensure_fresh_chat(page, svc)

    try:
        page.wait_for_selector(svc["input_sel"], timeout=15000)
    except PlaywrightTimeout:
        raise StepFailure(
            "the prompt input never appeared",
            "The page may have changed, or the session expired.",
        )

    # Capture pre-send state so we can confirm a *new* reply actually appears.
    # Gemini sometimes clears the composer (which _send_prompt reads as "sent")
    # without the message landing; we must not return the previous turn's text.
    before = get_page_state(page, svc)
    before_reply = _latest_assistant_text(page, svc) or ""

    progressed = False
    for attempt in range(2):
        # Attach on the first try only; re-uploading on a retry would double it.
        _send_prompt(page, svc, message, edit_image=(upload_path if attempt == 0 else None))
        wait_response_done(page, svc, timeout=180, failure_check=check_quota_only)
        # Give the reply a moment to render, then confirm it actually progressed.
        deadline = time.time() + 15
        while time.time() < deadline:
            if _reply_progressed(page, svc, before, before_reply):
                progressed = True
                break
            time.sleep(0.5)
        if progressed:
            break
        debug(f"send attempt {attempt + 1}: no new reply appeared; retrying")

    if not progressed:
        raise StepFailure(
            "the message didn't reach Gemini (no new reply appeared)",
            "Try again — if it persists the composer/send may have changed; run 'conjure doctor gemini'.",
        )

    reply = (_latest_assistant_text(page, svc) or "").strip()
    conv_id = _conversation_id(page.url)
    images = []
    for img in find_new_images(page, before["image_srcs"]):
        data = _image_bytes(page, img, "gemini")
        if data:
            images.append(data)
    # A new chat's title is generated async after the first turn — poll briefly.
    title = _conversation_title(page)
    if not title:
        deadline = time.time() + 6
        while time.time() < deadline and not title:
            time.sleep(0.6)
            title = _conversation_title(page)
    return {"reply": reply, "conversation_id": conv_id, "images": images, "title": title}


def do_chat(message, continue_id=None):
    """Send a chat message to Gemini and print the reply. Starts a fresh chat,
    or resumes an existing one when continue_id is given. Gemini-only in v1."""
    svc = SERVICES["gemini"]

    if continue_id:
        print(f"Continuing chat {_conversation_id(continue_id) or continue_id} (gemini): {message}")
    else:
        print(f"New chat (gemini): {message}")

    ctx, page = launch_browser(svc["profile"])
    try:
        page.goto(svc["url"])
        ensure_logged_in(page, svc)
        print("Waiting for reply...")
        result = chat_once(page, svc, message, continue_id=continue_id)

        reply_text = result["reply"]
        conv_id = result["conversation_id"]

        # Write any harvested images to the cwd, named from the message.
        saved = []
        if result["images"]:
            ts = datetime.now().strftime("%Y%m%d-%H%M%S")
            slug = slugify(message) or "gemini-image"
            for i, data in enumerate(result["images"]):
                suffix = "" if len(result["images"]) == 1 else f"-{i + 1}"
                filepath = Path.cwd() / f"{slug}-{ts}{suffix}.png"
                filepath.write_bytes(data)
                saved.append(filepath)

        print()
        if reply_text:
            print(reply_text)
        elif saved:
            print("(image reply)")
        else:
            print("(no reply captured)")
        for filepath in saved:
            print(f"Saved image: {filepath}")
        print()
        if conv_id:
            print(f"[chat {conv_id}]  continue with:  conjure chat -c {conv_id} \"...\"")

    except ServiceFailure as exc:
        try:
            time.sleep(2)
            final_text = _latest_assistant_text(page, svc) or exc.message
        except Exception:
            final_text = exc.message
        print("\ngemini: usage quota reached. Response:\n  " + final_text.replace("\n", "\n  "))
        sys.exit(2)
    except StepFailure as exc:
        print(f"\ngemini: {exc.step}.")
        if exc.hint:
            print(f"  {exc.hint}")
        dest = capture_diagnostics(page, svc, exc.step)
        if dest:
            print(f"  Diagnostics saved: {dest}")
        sys.exit(3)
    except KeyboardInterrupt:
        print("\nCancelled.")
    except Exception as exc:
        debug(f"unexpected error: {exc!r}")
        print(f"\nUnexpected error: {exc}")
        dest = capture_diagnostics(page, svc, f"unexpected: {type(exc).__name__}: {exc}")
        if dest:
            print(f"  Diagnostics saved: {dest}")
        sys.exit(1)
    finally:
        try:
            ctx.close()
        except Exception:
            pass


def _open_sidebar(page):
    """Open Gemini's side nav so the Recents conversation list is in the DOM.
    Gemini collapses the nav by default; when collapsed there are no
    conversation links to scrape."""
    try:
        if page.locator('a[href*="/app/"]').count() > 0:
            return  # already open
        btn = page.locator(
            'button[aria-label="Open sidebar"], [data-test-id="side-nav-sparkle-button"]'
        ).first
        if btn.count() and btn.is_visible():
            btn.click()
            time.sleep(1.5)
        if page.locator('a[href*="/app/"]').count() == 0:
            rec = page.locator('button[aria-label="Toggle Recents"]').first
            if rec.count() and rec.is_visible():
                rec.click()
                time.sleep(1.5)
    except Exception as exc:
        debug(f"_open_sidebar failed: {exc}")


def _scrape_conversations(page, svc, limit=30):
    """Scrape (id, title) pairs from the Gemini sidebar conversation links."""
    out = []
    seen = set()
    links = page.locator(svc["chats_sel"])
    for i in range(links.count()):
        try:
            el = links.nth(i)
            # Only clean /app/<hex> links are conversations; skip the account
            # menu link (/app/<id>&ec=…) and anything with query junk.
            m = _CONV_HREF_RE.match((el.get_attribute("href") or "").strip())
            if not m:
                continue
            conv_id = m.group(1)
            if conv_id in seen:
                continue
            title = (el.get_attribute("aria-label") or el.inner_text() or "").strip()
            title = " ".join(title.split())
            seen.add(conv_id)
            out.append((conv_id, title or "(untitled)"))
            if len(out) >= limit:
                break
        except Exception as exc:
            debug(f"scrape conversation {i} failed: {exc}")
            continue
    return out


def _scrape_transcript(page, svc, max_images=8):
    """Extract the ordered transcript of the CURRENT conversation as a list of
    {role, text, images} messages. Walks .conversation-container (each holds one
    user query + one model response), stripping the 'You said ' a11y prefix and
    the source-citation chips.

    Generated images are lazy (loading=lazy, blob: src, not decoded until in
    view) and their blob URLs aren't fetchable, so each AI-generated image
    (alt='…AI generated') is scrolled to centre to force-decode it, then
    captured via canvas. Done in one async evaluate to avoid per-image round
    trips."""
    try:
        raw = page.evaluate(
            r"""async ([chipSel, maxImages]) => {
                const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
                const strip = (el) => {
                    if (!el) return '';
                    const chips = el.querySelectorAll(chipSel);
                    const prev = [];
                    chips.forEach((e) => { prev.push(e.style.display); e.style.display = 'none'; });
                    let t = '';
                    try { t = (el.innerText || '').trim(); }
                    finally { chips.forEach((e, i) => { e.style.display = prev[i] || ''; }); }
                    return t;
                };
                const capture = async (im) => {
                    try { im.scrollIntoView({ block: 'center' }); } catch (e) {}
                    let tries = 0;
                    while (!im.naturalWidth && tries < 20) { await sleep(300); tries++; }
                    if (!im.naturalWidth) return '';
                    try {
                        const cv = document.createElement('canvas');
                        cv.width = im.naturalWidth; cv.height = im.naturalHeight;
                        cv.getContext('2d').drawImage(im, 0, 0);
                        return (cv.toDataURL('image/png').split(',')[1]) || '';
                    } catch (e) { return ''; }
                };
                let budget = maxImages;
                const out = [];
                for (const c of document.querySelectorAll('.conversation-container')) {
                    // Only pay the lazy-load scroll/wait for turns that actually
                    // have media; text-only turns skip it (~0.45s saved each).
                    if (c.querySelector('img[alt*="AI generated"], img.preview-image, img[alt="Uploaded image preview"], .file-preview-container')) {
                        try { c.scrollIntoView({ block: 'center' }); } catch (e) {}
                        await sleep(450);
                    }

                    const q = c.querySelector('.query-text')
                        || c.querySelector('user-query-content') || c.querySelector('user-query');
                    let user = q ? (q.innerText || '').trim() : '';
                    user = user.replace(/^You said\s*/i, '').trim();
                    const model = strip(c.querySelector('message-content'));

                    // user-uploaded images: collect srcs only — they're served
                    // cross-origin (googleusercontent), so canvas taints and
                    // fetch is CORS-blocked; fetched server-side via Playwright.
                    const userImageSrcs = [], userFiles = [];
                    for (const im of c.querySelectorAll('img.preview-image, img[alt="Uploaded image preview"]')) {
                        if (im.src && !im.src.startsWith('data:')) userImageSrcs.push(im.src);
                    }
                    // non-image uploads → filename chip
                    for (const fp of c.querySelectorAll('.file-preview-container')) {
                        if (fp.querySelector('img')) continue;
                        const name = (fp.innerText || '').replace(/\s+/g, ' ').trim();
                        if (name) userFiles.push(name.slice(0, 80));
                    }

                    // model-generated images (blob, same-origin → canvas works)
                    const modelImages = [];
                    for (const im of c.querySelectorAll('img[alt*="AI generated"]')) {
                        if (budget <= 0) break;
                        const b64 = await capture(im);
                        if (b64) { modelImages.push(b64); budget--; }
                    }
                    out.push({ user, model, userImageSrcs, userFiles, modelImages });
                }
                return out;
            }""",
            [_SOURCE_CHIP_SEL, max_images],
        )
    except Exception as exc:
        debug(f"_scrape_transcript failed: {exc}")
        return []

    messages = []
    budget = max_images
    for turn in raw:
        user_images = []
        for src in turn.get("userImageSrcs", []):
            if budget <= 0:
                break
            b64 = _request_image_b64(page, src)
            if b64:
                user_images.append(b64)
                budget -= 1
        if turn.get("user") or user_images or turn.get("userFiles"):
            messages.append({"role": "user", "text": turn.get("user", ""),
                             "images": user_images, "files": turn.get("userFiles", [])})
        if turn.get("model") or turn.get("modelImages"):
            messages.append({"role": "assistant", "text": turn.get("model", ""),
                             "images": turn.get("modelImages", []), "files": []})
    return messages


def do_list_chats():
    """List recent Gemini conversations scraped from the sidebar."""
    svc = SERVICES["gemini"]
    ctx, page = launch_browser(svc["profile"])
    try:
        page.goto(svc["url"])
        ensure_logged_in(page, svc)
        _open_sidebar(page)  # nav is collapsed by default
        time.sleep(1)
        convos = _scrape_conversations(page, svc)
        if not convos:
            print("No conversations found in the sidebar.")
            dest = capture_diagnostics(page, svc, "chats: nothing scraped")
            if dest:
                print(f"  Diagnostics saved: {dest}")
            return 1
        print(f"Recent Gemini conversations ({len(convos)}):\n")
        for conv_id, title in convos:
            print(f"  {conv_id}  {title}")
        print('\nContinue one with:  conjure chat -c <id> "..."')
        return 0
    except KeyboardInterrupt:
        print("\nCancelled.")
        return 1
    except Exception as exc:
        debug(f"chats error: {exc!r}")
        print(f"Couldn't list conversations: {exc}")
        dest = capture_diagnostics(page, svc, f"chats: {type(exc).__name__}: {exc}")
        if dest:
            print(f"  Diagnostics saved: {dest}")
        return 1
    finally:
        try:
            ctx.close()
        except Exception:
            pass


# ── API keys & server ─────────────────────────────────────────────
#
# conjure can run as a small local HTTP API in front of a single warm browser
# session: one Chromium launch, then every request reuses it (no per-call cold
# start). Clients authenticate with conjure-issued keys (random tokens, stored
# hashed). The server is single-threaded, so browser operations naturally
# serialize through the one page and stay on the thread that created it.

API_KEYS_PATH = CONFIG_DIR / "api_keys.json"


def _hash_key(raw):
    return hashlib.sha256(raw.encode()).hexdigest()


def _load_api_keys():
    try:
        return json.loads(API_KEYS_PATH.read_text())
    except Exception:
        return []


def _save_api_keys(keys):
    API_KEYS_PATH.parent.mkdir(parents=True, exist_ok=True)
    API_KEYS_PATH.write_text(json.dumps(keys, indent=2))
    try:
        API_KEYS_PATH.chmod(0o600)
    except Exception:
        pass


def _create_api_key(label=None):
    """Mint a new API key. Returns (raw_token, entry); only the hash is stored."""
    keys = _load_api_keys()
    raw = "cjr_" + secrets.token_hex(24)
    entry = {
        "label": label or "key",
        "prefix": raw[:12],
        "hash": _hash_key(raw),
        "created": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
    }
    keys.append(entry)
    _save_api_keys(keys)
    return raw, entry


def _revoke_api_key(label):
    """Revoke keys matching a label or prefix. Returns the count removed."""
    keys = _load_api_keys()
    kept = [k for k in keys
            if label not in (k["label"], k["prefix"]) and not k["prefix"].startswith(label)]
    _save_api_keys(kept)
    return len(keys) - len(kept)


def do_key(action, label=None):
    """Manage conjure's own API keys. Only a SHA-256 hash is stored; the raw
    token is shown once at creation."""
    if action == "new":
        raw, entry = _create_api_key(label)
        print("New API key — shown once, store it now:\n")
        print(f"    {raw}\n")
        print(f"  label={entry['label']}  prefix={entry['prefix']}")
        return 0
    if action == "list":
        keys = _load_api_keys()
        if not keys:
            print("No API keys yet. Create one: conjure key new [label]")
            return 0
        print(f"{len(keys)} API key(s):")
        for k in keys:
            print(f"  {k['prefix']}…  {k['label']:<16} created {k.get('created', '?')}")
        return 0
    if action == "revoke":
        if not label:
            print("Usage: conjure key revoke <label-or-prefix>")
            return 1
        print(f"Revoked {_revoke_api_key(label)} key(s).")
        return 0
    print(f"Unknown key action: {action}")
    return 1


WEB_DIR = Path(__file__).resolve().parent / "web"
_CONTENT_TYPES = {
    ".html": "text/html; charset=utf-8", ".css": "text/css",
    ".js": "application/javascript", ".svg": "image/svg+xml",
    ".png": "image/png", ".ico": "image/x-icon", ".woff2": "font/woff2",
    ".json": "application/json",
}


class _APIHandler(BaseHTTPRequestHandler):
    """Native conjure API + static UI over a warm Gemini browser session.

    Localhost requests are trusted (the local UI needs no key); the keys minted
    here are for external clients. Key management is localhost-only."""

    def log_message(self, fmt, *args):
        debug("http: " + (fmt % args))

    def _send(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _send_bytes(self, code, body, content_type):
        self.send_response(code)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _is_local(self):
        host = self.client_address[0] if self.client_address else ""
        return host in ("127.0.0.1", "::1", "localhost")

    def _authorized(self):
        # Localhost (the UI) is trusted; external clients need a valid key.
        if self._is_local():
            return True
        auth = self.headers.get("Authorization", "")
        if not auth.startswith("Bearer "):
            return False
        return _hash_key(auth[7:].strip()) in self.server.key_hashes

    def _refresh_keys(self):
        self.server.key_hashes = {k["hash"] for k in _load_api_keys()}

    def _read_json(self):
        length = int(self.headers.get("Content-Length", 0) or 0)
        try:
            return json.loads(self.rfile.read(length) or b"{}")
        except Exception:
            return None

    def _serve_static(self, path):
        rel = "index.html" if path in ("", "/") else path.lstrip("/")
        try:
            target = (WEB_DIR / rel).resolve()
            target.relative_to(WEB_DIR)  # reject path traversal
        except (ValueError, OSError):
            return self._send(404, {"error": "not found"})
        if not target.is_file():
            return self._send(404, {"error": "not found (build the web/ UI)"})
        self._send_bytes(200, target.read_bytes(),
                         _CONTENT_TYPES.get(target.suffix, "application/octet-stream"))

    def do_GET(self):
        path = self.path.split("?")[0]
        if path == "/health":
            return self._send(200, {"ok": True, "service": "gemini"})

        # Anything that isn't an API route is a static UI asset (no auth needed).
        if not path.startswith(("/chat", "/chats", "/keys")):
            return self._serve_static(path)

        if not self._authorized():
            return self._send(401, {"error": "unauthorized"})

        if path == "/chats":
            page, svc = self.server.page, self.server.svc
            try:
                page.goto(svc["url"])
                _open_sidebar(page)  # nav is collapsed by default
                try:
                    page.wait_for_selector(svc["chats_sel"], timeout=8000)
                except Exception:
                    pass
                time.sleep(0.5)
                convos = _scrape_conversations(page, svc)
                return self._send(200, {"conversations": [{"id": i, "title": t} for i, t in convos]})
            except Exception as exc:
                debug(f"/chats error: {exc!r}")
                return self._send(500, {"error": str(exc)})

        mc = re.match(r"^/chats/([0-9a-fA-F]{6,})$", path)
        if mc:
            conv_id = mc.group(1)
            page, svc = self.server.page, self.server.svc
            try:
                page.goto(f"{svc['url'].rstrip('/')}/{conv_id}")
                try:
                    page.wait_for_selector("message-content", timeout=20000)
                except Exception:
                    pass
                time.sleep(0.6)
                return self._send(200, {"conversation_id": conv_id,
                                        "messages": _scrape_transcript(page, svc)})
            except Exception as exc:
                debug(f"/chats/{conv_id} error: {exc!r}")
                return self._send(500, {"error": str(exc)})

        if path == "/keys":
            if not self._is_local():
                return self._send(403, {"error": "key management is localhost-only"})
            keys = [{"label": k["label"], "prefix": k["prefix"], "created": k.get("created")}
                    for k in _load_api_keys()]
            return self._send(200, {"keys": keys})

        return self._send(404, {"error": "not found"})

    def do_POST(self):
        path = self.path.split("?")[0]
        if not self._authorized():
            return self._send(401, {"error": "unauthorized"})

        if path == "/keys":
            if not self._is_local():
                return self._send(403, {"error": "key management is localhost-only"})
            body = self._read_json()
            if body is None:
                return self._send(400, {"error": "invalid JSON body"})
            raw, entry = _create_api_key((body.get("label") or "key").strip() or "key")
            self._refresh_keys()
            return self._send(200, {"key": raw, "label": entry["label"],
                                    "prefix": entry["prefix"], "created": entry["created"]})

        if path != "/chat":
            return self._send(404, {"error": "not found"})
        body = self._read_json()
        if body is None:
            return self._send(400, {"error": "invalid JSON body"})
        message = (body.get("message") or "").strip()
        file_obj = body.get("file") or None
        if not message and not file_obj:
            return self._send(400, {"error": "message or file is required"})
        continue_id = body.get("conversation_id") or None

        # Materialise an uploaded file to a temp path (under its real name, so
        # Gemini sees the right type) if one was sent.
        upload_path, tmp_dir = None, None
        if file_obj and file_obj.get("data"):
            try:
                tmp_dir = tempfile.mkdtemp(prefix="conjure-up-")
                name = os.path.basename(file_obj.get("name") or "") or "upload"
                upload_path = os.path.join(tmp_dir, name)
                with open(upload_path, "wb") as fh:
                    fh.write(base64.b64decode(file_obj["data"]))
            except Exception as exc:
                if tmp_dir:
                    shutil.rmtree(tmp_dir, ignore_errors=True)
                debug(f"/chat: bad file payload: {exc}")
                return self._send(400, {"error": "invalid file payload"})

        # Rate gate: keep a minimum gap between Gemini sends.
        wait = self.server.min_interval - (time.time() - self.server.last_op)
        if wait > 0:
            time.sleep(wait)
        self.server.last_op = time.time()

        try:
            result = chat_once(self.server.page, self.server.svc, message,
                               continue_id=continue_id, upload_path=upload_path)
        except ServiceFailure as exc:
            return self._send(429, {"error": "quota", "detail": exc.message[:200]})
        except StepFailure as exc:
            return self._send(503, {"error": exc.step, "hint": exc.hint})
        except Exception as exc:
            debug(f"/chat error: {exc!r}")
            return self._send(500, {"error": str(exc)})
        finally:
            if tmp_dir:
                shutil.rmtree(tmp_dir, ignore_errors=True)

        return self._send(200, {
            "reply": result["reply"],
            "conversation_id": result["conversation_id"],
            "images": [base64.b64encode(d).decode() for d in result["images"]],
            "title": result.get("title"),
        })

    def do_DELETE(self):
        path = self.path.split("?")[0]
        md = re.match(r"^/keys/(.+)$", path)
        if not md:
            return self._send(404, {"error": "not found"})
        if not self._is_local():
            return self._send(403, {"error": "key management is localhost-only"})
        n = _revoke_api_key(md.group(1))
        self._refresh_keys()
        return self._send(200, {"revoked": n})


def do_serve(host, port):
    """Run the local API server + web UI over one warm Gemini browser session."""
    svc = SERVICES["gemini"]
    keys = _load_api_keys()

    print(f"Starting conjure server — launching warm browser ({svc['url']}) ...")
    ctx, page = launch_browser(svc["profile"])
    try:
        page.goto(svc["url"])
        try:
            page.wait_for_selector(svc["input_sel"], timeout=15000)
        except PlaywrightTimeout:
            pass
        if not is_logged_in(page, svc):
            print("Not logged in. Run:  conjure login gemini")
            return 1
        print("✓ logged in; browser warm")

        try:
            server = HTTPServer((host, port), _APIHandler)
        except OSError as exc:
            print(f"Could not bind {host}:{port} — {exc}")
            print(f"  Port {port} may be in use; try: conjure serve --port <other>")
            return 1
        server.svc = svc
        server.page = page
        server.key_hashes = {k["hash"] for k in keys}
        server.last_op = 0.0
        server.min_interval = 1.5

        print(f"\n  conjure → http://{host}:{port}   (open this in your browser)")
        print(f"  API: POST /chat · GET /chats · GET /chats/<id> · /keys   "
              f"({len(keys)} key(s) for external clients)")
        print("  Localhost is trusted (no key needed); Ctrl+C to stop.\n")
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nShutting down.")
    finally:
        try:
            ctx.close()
        except Exception:
            pass
    return 0


# ── CLI ───────────────────────────────────────────────────────────


def build_parser():
    # -v lives on a shared parent so it appears in every subcommand's --help;
    # main() resolves its value directly (see there) to dodge argparse's
    # subparser-namespace reset.
    parent = argparse.ArgumentParser(add_help=False)
    parent.add_argument(
        "-v", "--verbose", action="store_true",
        help="print a step-by-step diagnostic trace to stderr",
    )

    parser = argparse.ArgumentParser(
        prog="conjure",
        description="Chat with Gemini (and generate images) via browser automation",
        parents=[parent],
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            '  conjure "what is the capital of France?"      (start a new chat)\n'
            '  conjure -c <id> "and its population?"         (continue a chat)\n'
            "  conjure chats                                 (list conversations)\n"
            '  conjure image "a samurai cat in the rain"     (generate an image)\n'
            '  conjure image --edit photo.png "make it night"\n'
            "  conjure login gemini\n"
            "  conjure doctor\n\n"
            "A bare prompt starts a new Gemini chat; subcommands cover the rest."
        ),
    )
    sub = parser.add_subparsers(dest="command")

    p_chat = sub.add_parser(
        "chat", parents=[parent],
        help="send a message (new chat, or continue an existing one with -c)",
    )
    p_chat.add_argument(
        "-c", "--continue", dest="continue_id", metavar="ID",
        help="continue a conversation by id (or a full /app/<id> URL)",
    )
    p_chat.add_argument("message", nargs="*", help="the message to send")

    sub.add_parser("chats", parents=[parent], help="list recent conversations")

    p_img = sub.add_parser("image", parents=[parent], help="generate or edit an image")
    grp = p_img.add_mutually_exclusive_group()
    grp.add_argument("--gemini", dest="service", action="store_const", const="gemini",
                     help="use Gemini (default)")
    grp.add_argument("--chatgpt", dest="service", action="store_const", const="chatgpt",
                     help="use ChatGPT")
    p_img.set_defaults(service="gemini")
    p_img.add_argument("--edit", metavar="IMAGE", type=Path, help="upload an image and edit it")
    p_img.add_argument("prompt", nargs="*", help="image prompt")

    p_login = sub.add_parser("login", parents=[parent], help="log in and save the session")
    p_login.add_argument("service", nargs="?", default="gemini",
                         help="chatgpt or gemini (default: gemini)")

    p_doctor = sub.add_parser("doctor", parents=[parent],
                              help="environment + selector health checks")
    p_doctor.add_argument("service", nargs="?", help="chatgpt or gemini (default: all)")

    p_serve = sub.add_parser("serve", parents=[parent],
                             help="run the local API server over a warm browser session")
    p_serve.add_argument("--host", default="127.0.0.1", help="bind host (default: 127.0.0.1)")
    p_serve.add_argument("--port", type=int, default=8765, help="bind port (default: 8765)")

    p_key = sub.add_parser("key", parents=[parent], help="manage conjure API keys")
    p_key.add_argument("action", choices=["new", "list", "revoke"])
    p_key.add_argument("label", nargs="?", help="label (new) or label/prefix to revoke")

    return parser


def main():
    known = {"chat", "chats", "image", "login", "doctor", "serve", "key"}
    raw = sys.argv[1:]
    if not raw:
        build_parser().print_help()
        return

    # Resolve --verbose ourselves (works in any position), then strip it so the
    # chosen subparser's default doesn't reset it back to False.
    verbose = any(t in ("-v", "--verbose") for t in raw)
    raw = [t for t in raw if t not in ("-v", "--verbose")]
    set_verbose(verbose)

    # A bare invocation (no recognized subcommand) is treated as a new chat,
    # so `conjure "hello"` just works. The first non-flag token decides.
    first_pos = next((t for t in raw if not t.startswith("-")), None)
    if first_pos is None:
        build_parser().print_help()
        return
    if first_pos not in known:
        raw = ["chat"] + raw

    parser = build_parser()
    args = parser.parse_args(raw)
    command = args.command or "chat"

    if command == "doctor":
        if args.service:
            if args.service not in SERVICES:
                parser.error(f"unknown service: {args.service}. Use: chatgpt or gemini")
            targets = [args.service]
        else:
            targets = list(SERVICES.keys())
        sys.exit(do_doctor(targets))

    if command == "login":
        if args.service not in SERVICES:
            parser.error(f"unknown service: {args.service}. Use: chatgpt or gemini")
        do_login(args.service)
        return

    if command == "chats":
        sys.exit(do_list_chats())

    if command == "serve":
        sys.exit(do_serve(args.host, args.port))

    if command == "key":
        sys.exit(do_key(args.action, args.label))

    if command == "image":
        edit_image = None
        if args.edit is not None:
            edit_image = args.edit.resolve()
            if not edit_image.is_file():
                parser.error(f"file not found: {edit_image}")
        prompt = " ".join(args.prompt).strip()
        if not prompt:
            parser.error("an image prompt is required")
        do_generate(args.service, prompt, edit_image=edit_image)
        return

    # chat (explicit `chat` subcommand or a bare prompt)
    message = " ".join(args.message).strip()
    if not message:
        parser.error('a message is required, e.g. conjure "hello"')
    do_chat(message, continue_id=args.continue_id)


if __name__ == "__main__":
    main()
