def _probe_send_selector(page, svc):
    """Verify the send control by typing a throwaway string, checking the
    button resolves and is enabled, then clearing the field. Never sends.

    Returns (ok, status): ok is True/False for a clear pass/fail, or None when
    it genuinely could not be verified (so doctor warns rather than fails)."""
    probe_text = "conjure doctor probe — ignore"
    field = page.locator(svc["input_sel"])
    try:
        field.click()
        try:
            field.fill(probe_text)
        except Exception:
            page.keyboard.type(probe_text, delay=5)
        time.sleep(0.5)
        send = page.locator(svc["send_sel"])
        count = send.count()
        if count == 0:
            result = (False, f"send button matched nothing: {svc['send_sel']}")
        elif not send.first.is_enabled():
            result = (None, f"send button present but disabled (may just need a moment): {svc['send_sel']}")
        else:
            result = (True, f"send button resolves and is enabled: {svc['send_sel']}")
    except Exception as exc:
        result = (None, f"could not verify send button ({exc})")
    # Always clear the throwaway text so a later real run is unaffected.
    try:
        field.fill("")
    except Exception:
        try:
            page.keyboard.press("Control+A")
            page.keyboard.press("Delete")
        except Exception:
            pass
    return result


def _doctor_probe_service(name, svc):
    """Launch a headless browser, load the service, and report login state plus
    live resolution of the static selectors. Read-only — sends no prompt."""
    print(f"  launching headless browser → {svc['url']}")
    try:
        ctx, page = launch_browser(svc["profile"])
    except Exception as exc:
        print(f"  ✗ could not launch browser: {exc}")
        return False
    try:
        try:
            page.goto(svc["url"], timeout=30000)
        except Exception as exc:
            print(f"  ✗ navigation failed: {exc}")
            return False
        try:
            page.wait_for_selector(svc["input_sel"], timeout=15000)
        except PlaywrightTimeout:
            pass

        # Login gate first: a logged-out page is a login wall, so every
        # downstream selector would falsely read as "broken".
        if not is_logged_in(page, svc):
            print(f"  ✗ not logged in — run: conjure --login {name}")
            print("    (skipping selector checks; the page is a login wall)")
            return False
        print("  ✓ logged in")

        ok = True

        count = page.locator(svc["input_sel"]).count()
        good = count > 0
        ok = ok and good
        print(f"  {'✓' if good else '✗'} input selector  ({count} match)  {svc['input_sel']}")

        nc_matched = False
        nc_report = []
        for sel in svc.get("new_chat_sels", []):
            try:
                c = page.locator(sel).count()
            except Exception:
                c = 0
            nc_report.append((sel, c))
            nc_matched = nc_matched or c > 0
        # New-chat has a reload fallback in the real flow, so a miss is a
        # warning, not a hard failure.
        print(f"  {'✓' if nc_matched else '⚠'} new-chat selector  "
              + ("one variant matched" if nc_matched
                 else "none matched (reload fallback would be used)"))
        for sel, c in nc_report:
            print(f"        {c} match   {sel}")

        send_ok, send_status = _probe_send_selector(page, svc)
        if send_ok is False:
            ok = False
        send_mark = {True: "✓", False: "✗", None: "⚠"}[send_ok]
        print(f"  {send_mark} {send_status}")

        dynamic = [s for s in selector_specs(svc) if s[2] == "dynamic" and s[0] != "send"]
        if dynamic:
            print("  · dynamic selectors (only verifiable during a real run):")
            for label, sel, _ in dynamic:
                print(f"        {label:<10} {sel}")

        return ok
    finally:
        try:
            ctx.close()
        except Exception:
            pass


def do_doctor(targets):
    """Environment + selector health check. Returns a process exit code."""
    print("conjure doctor")
    print("─" * 48)

    if cloak_launch is None:
        print("✗ dependencies: NOT installed")
        if IMPORT_ERROR:
            print(f"    {IMPORT_ERROR}")
        print("    fix: cd conjure && ./setup")
        return 1
    print("✓ dependencies: cloakbrowser + playwright import OK")
    print(f"· config dir: {CONFIG_DIR} "
          f"({'exists' if CONFIG_DIR.exists() else 'missing (created on first login)'})")

    overall = True
    for name in targets:
        svc = SERVICES[name]
        print()
        print(f"── {name} ──────────────")
        profile = svc["profile"]
        if profile.exists():
            print(f"  ✓ profile: {profile}")
        else:
            print(f"  ✗ profile missing — run: conjure --login {name}")
            overall = False
            continue
        if not _doctor_probe_service(name, svc):
            overall = False

    print()
    if overall:
        print("All checks passed.")
    else:
        print("Some checks failed — see above. A '✗' on a static selector means "
              "the page markup changed; update that selector in the SERVICES table.")
    return 0 if overall else 1


def do_login(service_name):
    svc = SERVICES[service_name]
    print(f"Opening {service_name} for login...")
    ctx, page = launch_browser(svc["profile"], headless=False)
    try:
        page.goto(svc["url"])
        ensure_logged_in(page, svc, headless=False)
        print(f"Session saved for {service_name}.")
    except KeyboardInterrupt:
        print("\nCancelled.")
    finally:
        try:
            ctx.close()
        except Exception:
            pass


def do_generate(service_name, prompt, edit_image=None):
    svc = SERVICES[service_name]
    output_dir = Path.cwd()

    if edit_image:
        print(f"Editing ({service_name}): {edit_image.name} — {prompt}")
    else:
        print(f"Generating ({service_name}): {prompt}")

    ctx, page = launch_browser(svc["profile"])

    try:
        debug(f"navigating to {svc['url']}")
        page.goto(svc["url"])
        ensure_logged_in(page, svc)
        debug("logged in; ensuring a fresh chat")
        ensure_fresh_chat(page, svc)

        try:
            page.wait_for_selector(svc["input_sel"], timeout=15000)
        except PlaywrightTimeout:
            raise StepFailure(
                "the prompt input never appeared",
                f"The page layout may have changed, or the session may be invalid. "
                f"Run 'conjure --doctor {service_name}' to check.",
            )
        debug("prompt input ready")

        # Upload image if editing
        if edit_image:
            debug(f"uploading {edit_image}")
            try:
                svc["upload"](page, edit_image)
            except Exception as exc:
                raise StepFailure(
                    f"image upload failed ({exc})",
                    f"The upload control may have changed. "
                    f"Run 'conjure --doctor {service_name}' to check.",
                )
            # Wait for upload preview to appear (not a fixed delay)
            try:
                page.locator('img[src*="blob:"]').first.wait_for(timeout=30000)
            except PlaywrightTimeout:
                debug("upload preview did not appear within 30s; continuing anyway")
            time.sleep(1)

        # Type prompt
        textarea = page.locator(svc["input_sel"])
        textarea.click()
        time.sleep(0.3)

        prefix = svc["edit_prefix"] if edit_image else svc["prompt_prefix"]
        full_prompt = prefix + prompt
        try:
            textarea.fill(full_prompt)
        except Exception:
            page.keyboard.type(full_prompt, delay=10)

        time.sleep(0.5)
        baseline = get_page_state(page, svc)

        # Submit — wait for send button to be ready, then verify it went through
        send = page.locator(svc["send_sel"])
        try:
            send.wait_for(state="visible", timeout=10000)
        except PlaywrightTimeout:
            pass
        time.sleep(1)

        if send.count() > 0 and send.is_enabled():
            send.click()
        else:
            page.keyboard.press("Enter")

        # Verify message was sent relative to the pre-submit page state
        sent = wait_for_send_confirmation(page, svc, baseline)
        if not sent:
            debug("send not confirmed; retrying once")
            # Retry send
            send = page.locator(svc["send_sel"])
            if send.count() > 0 and send.is_enabled():
                send.click()
            else:
                page.keyboard.press("Enter")
            time.sleep(10)
            sent = True  # best effort
        else:
            debug("send confirmed")

        before_srcs = baseline["image_srcs"]

        print("Waiting for image generation (this can take a minute)...")

        if not wait_response_done(page, svc, timeout=180):
            debug("wait_response_done timed out after 180s")
            print("Warning: timed out waiting for response.")
        else:
            debug("response generation complete")

        print("Waiting for image to finish rendering...")
        if not wait_for_images(page, before_srcs, svc):
            debug("wait_for_images timed out")
            print("Warning: images may not be fully rendered.")
        else:
            debug("image detected in response")

        # Find and save the best image
        timestamp = datetime.now().strftime("%Y%m%d-%H%M%S")
        slug = slugify(prompt)
        filename = f"{slug}-{timestamp}.png"
        filepath = output_dir / filename

        best = find_best_image(page, before_srcs)
        if not best:
            # Retry — image may still be loading
            for _ in range(3):
                time.sleep(10)
                try:
                    check_for_failure(page, svc)
                except ServiceFailure:
                    raise
                best = find_best_image(page, before_srcs)
                if best:
                    break

        if best and save_image(page, best, filepath, service_name):
            print(f"Saved: {filepath}")
            debug("image saved successfully")
        else:
            assistant_text = _latest_assistant_text(page, svc)
            if best:
                print("Found an image in the response but could not save it.")
            elif assistant_text:
                print(
                    f"No image in response. {service_name} replied with text:\n  "
                    + assistant_text.replace("\n", "\n  ")
                )
            else:
                print(f"No image found in the {service_name} response.")
            dest = capture_diagnostics(
                page,
                svc,
                "image found but save failed" if best else "no image in response",
            )
            if dest:
                print(f"Diagnostics saved: {dest}")
            sys.exit(4)

    except ServiceFailure as exc:
        # Let the assistant finish streaming before snapshotting the reply,
        # otherwise the printed message may be truncated mid-word.
        try:
            time.sleep(2)
            final_text = _latest_assistant_text(page, svc) or exc.message
        except Exception:
            final_text = exc.message
        label = {
            "quota": "image quota reached",
            "error": "could not generate image",
        }.get(exc.reason, exc.reason)
        print(
            f"\n{service_name}: {label}. Response:\n  "
            + final_text.replace("\n", "\n  ")
        )
        sys.exit(2)
    except StepFailure as exc:
        print(f"\n{service_name}: {exc.step}.")
        if exc.hint:
            print(f"  {exc.hint}")
        dest = capture_diagnostics(page, svc, exc.step)
        if dest:
            print(f"  Diagnostics saved: {dest}")
        sys.exit(3)
    except KeyboardInterrupt:
        print("\nCancelled.")
    except Exception as exc:
        debug(f"unexpected error: {exc!r}")
        print(f"\nUnexpected error: {exc}")
        dest = capture_diagnostics(page, svc, f"unexpected: {type(exc).__name__}: {exc}")
        if dest:
            print(f"  Diagnostics saved: {dest}")
        sys.exit(1)
    finally:
        try:
            ctx.close()
        except Exception:
            pass


