def build_parser():
    parser = argparse.ArgumentParser(
        prog="conjure",
        description="Generate and edit images via ChatGPT and Gemini",
        epilog=(
            "Examples:\n"
            '  conjure "a cat in a top hat"\n'
            '  conjure --gemini "a red panda"\n'
            '  conjure --edit img.png "add sunset"\n'
            '  conjure --gemini --edit img.png "make it night"\n'
            "  conjure --login gemini\n\n"
            "Each run starts from a fresh chat before sending the prompt."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    service = parser.add_mutually_exclusive_group()
    service.add_argument(
        "--chatgpt",
        dest="service",
        action="store_const",
        const="chatgpt",
        help="use ChatGPT (default)",
    )
    service.add_argument(
        "--gemini",
        dest="service",
        action="store_const",
        const="gemini",
        help="use Gemini",
    )
    parser.set_defaults(service="chatgpt")
    parser.add_argument(
        "--edit",
        metavar="IMAGE",
        type=Path,
        help="upload an image and edit it",
    )
    parser.add_argument(
        "--login",
        nargs="?",
        const="",
        metavar="SERVICE",
        help="open a browser to log in and save the session",
    )
    parser.add_argument(
        "--doctor",
        nargs="?",
        const="",
        metavar="SERVICE",
        help="run environment + selector health checks (all services, or one) and exit",
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="print a step-by-step diagnostic trace to stderr",
    )
    parser.add_argument(
        "prompt",
        nargs="*",
        help="image prompt",
    )
    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()

    set_verbose(args.verbose)

    if args.doctor is not None:
        if args.doctor:
            if args.doctor not in SERVICES:
                parser.error(f"unknown service: {args.doctor}. Use: chatgpt or gemini")
            targets = [args.doctor]
        else:
            targets = list(SERVICES.keys())
        sys.exit(do_doctor(targets))

    if args.login is not None:
        service = args.login or args.service
        if service not in SERVICES:
            parser.error(f"unknown service: {service}. Use: chatgpt or gemini")
        do_login(service)
        return

    edit_image = None
    if args.edit is not None:
        edit_image = args.edit.resolve()
        if not edit_image.is_file():
            parser.error(f"file not found: {edit_image}")

    prompt = " ".join(args.prompt).strip()
    if not prompt:
        parser.error('the prompt is required unless "--login" is used')

    do_generate(args.service, prompt, edit_image=edit_image)


if __name__ == "__main__":
    main()
