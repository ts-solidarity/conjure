# ── Failure detection ────────────────────────────────────────────
#
# When ChatGPT or Gemini cannot fulfill the request (quota hit, content
# policy refusal, internal error) they reply with text only — no image.
# Without these checks the CLI would hang for the full image-wait timeout
# (~5 minutes) before reporting a generic "No image found".

QUOTA_PATTERNS = [
    r"hit the free plan limit",
    r"reached your image creation limit",
    r"image creation limit",
    r"limit resets in",
    r"try again tomorrow",
]

ERROR_PATTERNS = [
    r"\bsomething went wrong\b",
    r"unable to generate",
    r"error generating",
    r"can'?t (?:create|generate|make|produce) (?:that|this|the|an? )?image",
    r"wasn'?t able to (?:create|generate|make)",
    r"this (?:request|content) (?:may )?violate",
    r"violates? (?:our )?(?:content )?polic",
    r"can'?t help with that request",
]


class ServiceFailure(Exception):
    """Raised when the service returns a text-only refusal/error instead of an image."""

    def __init__(self, reason: str, message: str):
        self.reason = reason
        self.message = message
        super().__init__(f"{reason}: {message[:120]}")


def _latest_assistant_text(page, svc) -> str:
    response_sel = svc.get("response_sel")
    try:
        if response_sel:
            return page.evaluate(
                """(sel) => {
                    const els = document.querySelectorAll(sel);
                    if (!els.length) return '';
                    return (els[els.length - 1].innerText || '').trim();
                }""",
                response_sel,
            )
        return page.evaluate(
            """() => {
                const turns = document.querySelectorAll('[data-turn="assistant"]');
                if (!turns.length) return '';
                return (turns[turns.length - 1].innerText || '').trim();
            }"""
        )
    except Exception:
        return ""


def check_for_failure(page, svc):
    """Raise ServiceFailure if the latest assistant message indicates the request failed."""
    text = _latest_assistant_text(page, svc)
    if not text:
        return
    low = text.lower()
    for pat in QUOTA_PATTERNS:
        if re.search(pat, low):
            raise ServiceFailure("quota", text)
    for pat in ERROR_PATTERNS:
        if re.search(pat, low):
            raise ServiceFailure("error", text)


# ── Diagnostics & logging ─────────────────────────────────────────
#
# Automating a third-party web UI is inherently brittle: a selector change
# upstream surfaces here as a silent "no image" or a hang. These helpers make
# failures legible — an opt-in step trace (--verbose) and an on-failure bundle
# (screenshot + DOM + live selector counts). The bundle is written under the
# config dir, never cwd: the DOM contains the account name and conversation
# history, so writing it into a working directory risks committing it.

DEBUG_DIR = CONFIG_DIR / "debug"

_VERBOSE = False


def set_verbose(value: bool):
    global _VERBOSE
    _VERBOSE = bool(value)


def debug(msg: str):
    """Timestamped step/error trace — shown only with --verbose, on stderr."""
    if _VERBOSE:
        print(f"[{datetime.now():%H:%M:%S}] {msg}", file=sys.stderr)


class StepFailure(Exception):
    """A brittle automation step failed (e.g. a selector stopped matching).

    Carries a human-readable step name and an actionable hint so the CLI can
    report it cleanly instead of surfacing a raw traceback."""

    def __init__(self, step: str, hint: str = ""):
        self.step = step
        self.hint = hint
        super().__init__(step)


def selector_specs(svc):
    """Selectors worth probing, each tagged 'static' (present on a freshly
    loaded page) or 'dynamic' (only present mid-run). --doctor and the
    diagnostics report use this; dynamic selectors must never be reported as
    broken just because they are absent on a fresh page."""
    specs = []
    if svc.get("input_sel"):
        specs.append(("input", svc["input_sel"], "static"))
    if svc.get("login_sels"):
        specs.append(("login-buttons", svc["login_sels"], "static"))
    for sel in svc.get("new_chat_sels", []):
        specs.append(("new-chat", sel, "static"))
    if svc.get("send_sel"):
        specs.append(("send", svc["send_sel"], "dynamic"))
    for sel in svc.get("stop_sels", []):
        specs.append(("stop", sel, "dynamic"))
    if svc.get("response_sel"):
        specs.append(("response", svc["response_sel"], "dynamic"))
    return specs


def capture_diagnostics(page, svc, step: str, extra: str = ""):
    """Write screenshot + DOM + a selector report to ~/.config/conjure/debug/<ts>/.

    Returns the directory, or None if nothing could be captured. Never raises —
    diagnostics must not mask the failure that triggered them."""
    try:
        ts = datetime.now().strftime("%Y%m%d-%H%M%S")
        dest = DEBUG_DIR / ts
        dest.mkdir(parents=True, exist_ok=True)
    except Exception as exc:
        debug(f"could not create debug dir: {exc}")
        return None

    captured = False
    try:
        page.screenshot(path=str(dest / "screenshot.png"), full_page=True)
        captured = True
    except Exception as exc:
        debug(f"screenshot capture failed: {exc}")
    try:
        (dest / "page.html").write_text(page.content(), encoding="utf-8")
        captured = True
    except Exception as exc:
        debug(f"DOM capture failed: {exc}")

    lines = [f"step: {step}"]
    try:
        lines.append(f"url:  {page.url}")
    except Exception:
        pass
    lines.append("")
    lines.append("selector resolution (matches on the page right now):")
    for label, sel, kind in selector_specs(svc):
        try:
            count = page.locator(sel).count()
        except Exception as exc:
            count = f"error: {exc}"
        lines.append(f"  [{kind:<7}] {label:<14} {count}   {sel}")
    try:
        text = _latest_assistant_text(page, svc)
        if text:
            lines.append("")
            lines.append("latest assistant text:")
            lines.append("  " + text[:1000].replace("\n", "\n  "))
    except Exception:
        pass
    if extra:
        lines.append("")
        lines.append(extra)
    try:
        (dest / "report.txt").write_text("\n".join(lines), encoding="utf-8")
        captured = True
    except Exception as exc:
        debug(f"report write failed: {exc}")

    return dest if captured else None


